generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  ONE_TO_ONE
  COMMUNITY
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum DeleteStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType
  title     String?
  createdAt DateTime @default(now())
}

model Message {
  id               String      @id @default(uuid())
  chatId           String
  senderId         String
  encryptedContent String
  nonce            String?
  messageType      MessageType @default(TEXT)
  isEdited         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  editedAt         DateTime?
}

model DeleteRequest {
  id           String       @id @default(uuid())
  chatId       String
  requestedBy  String
  targetUserId String?
  status       DeleteStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  approvedAt   DateTime?
}

model Community {
  id          String           @id @default(uuid())
  chatId      String
  name        String
  description String?
  privacy     CommunityPrivacy @default(PUBLIC)
  ownerId     String
  inviteCode  String?          @unique
  createdAt   DateTime         @default(now())
}

