# Copy to apps/backend/.env (never committed) to configure the server locally.
# On a hosted server the same settings live in the systemd environment file (see docs/DEPLOYMENT.md).
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Country for phone numbers typed without +<code>
DEFAULT_COUNTRY=IN

# ---- Email: sign-up codes, welcome, password reset, security alerts (free with a Gmail App Password) ----
# Without these, local dev writes emails to apps/backend/data/outbox/ instead of sending them.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your16letterapppassword
# MAIL_FROM=EliSecureChat <you@gmail.com>

# ---- SMS (paid): Twilio. Without these, local dev writes SMS to the outbox; production has no SMS. ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567

# Link used in emails ("Open EliSecureChat")
# APP_URL=http://localhost:5173
